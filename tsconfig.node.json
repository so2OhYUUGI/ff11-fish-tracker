{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": [
      "node"
    ] // ← この行を追加（"node" 型定義を読み込む）
  },
  "include": [
    "vite.config.ts",
    "vite/**/*.ts",
    "scripts/**/*.ts"
  ] // ← "scripts/**/*.ts" も含めておくと安全です
}